        "# Ejercicio 8.1 — Ruido con perfil espectral tipo EEG (energía en 1–40 Hz)\n",
        "\n",
        "def shape_eeg(f):\n",
        "    \"\"\"\n",
        "    Perfil espectral tipo EEG:\n",
        "    - Sube suavemente desde 0 Hz (evita DC con sigmoide en f=1)\n",
        "    - Cae suavemente a partir de 40 Hz (sigmoide de rolloff)\n",
        "    - El producto de ambas sigmoides forma una ventana suave tipo pasa-banda\n",
        "    \"\"\"\n",
        "    subida  = 1.0 / (1.0 + np.exp(-(f - 1.0) * 3.0))   # sube en f=1 Hz\n",
        "    bajada  = 1.0 / (1.0 + np.exp( (f - 40.0) * 0.4))  # cae en f=40 Hz\n",
