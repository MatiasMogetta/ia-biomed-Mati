        "    \"\"\"\n",
        "    Estira (factor > 1) o comprime (factor < 1) la señal en el tiempo.\n",
        "    Usa interpolación lineal para remuestrear al mismo largo original.\n",
        "    Un factor=1.2 simula una FC 20% menor (latidos más espaciados).\n",
        "    \"\"\"\n",
        "    t_stretched = np.linspace(t[0], t[-1] * factor, len(t))\n",
        "    ecg_stretched = np.interp(t, t_stretched, ecg)\n",
        "    return ecg_stretched\n",
        "\n",
        "def augment(t, ecg, rng):\n",
        "    \"\"\"\n",
        "    Pipeline de augmentation: aplica cada transformación con\n",
        "    probabilidad 0.7 y magnitudes sorteadas aleatoriamente.\n",
        "    \"\"\"\n",
        "    result = ecg.copy()\n",
        "    log = []\n",
        "\n",
        "    # 1. Ruido aditivo\n",
        "    if rng.random() < 0.7:\n",
        "        sigma = rng.uniform(0.02, 0.10)\n",
        "        result = add_noise(result, sigma, rng)\n",
        "        log.append(f'noise σ={sigma:.2f}')\n",
        "\n",
        "    # 2. Escalado de amplitud\n",
        "    if rng.random() < 0.7:\n",
        "        factor = rng.uniform(0.6, 1.4)\n",
        "        result = amplitude_scale(result, factor)\n",
        "        log.append(f'amp×{factor:.2f}')\n",
        "\n",
        "    # 3. Deriva de línea de base\n",
        "    if rng.random() < 0.7:\n",
        "        drift_hz  = rng.uniform(0.1, 0.4)\n",
        "        drift_amp = rng.uniform(0.1, 0.5)\n",
        "        result = add_baseline_drift(t, result, drift_hz, drift_amp)\n",
        "        log.append(f'drift {drift_hz:.2f}Hz')\n",
        "\n",
        "    # 4. Time stretch\n",
        "    if rng.random() < 0.7:\n",
        "        stretch = rng.uniform(0.8, 1.2)\n",
        "        result = time_stretch(t, result, stretch)\n",
        "        log.append(f'stretch×{stretch:.2f}')\n",
        "\n",
        "    return result, log\n",
        "\n",
        "# Grid de 6 versiones aumentadas\n",
        "rng = np.random.default_rng(42)\n",
        "fig, axes = plt.subplots(2, 3, figsize=(14, 6))\n",
