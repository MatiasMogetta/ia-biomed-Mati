      "source": [
        "## 4. Convolución 1D desde cero\n",
        "\n",
        "La convolución de una señal `x` con un kernel `h` se define como:\n",
        "\n",
        "$$y[n] = \\sum_k h[k] \\cdot x[n - k]$$\n",
        "\n",
        "Vamos a implementarla a mano y compararla con `np.convolve`."
      ],
      "id": "zgr2JfO2oCWH"
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "4OIgiDScoCWH",
        "outputId": "8c187b83-62ba-40d7-97aa-7a5f969d1670"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "manual: [0.25 1.   2.   2.5  2.   1.   0.25]\n",
            "numpy:  [0.25 1.   2.   2.5  2.   1.   0.25]\n",
            "iguales? True\n"
          ]
        }
      ],
      "source": [
        "def conv_manual(x, h):\n",
        "    \"\"\"Convolución 1D 'válida' implementada a mano (didáctica, no optimizada).\"\"\"\n",
        "    n = len(x); m = len(h)\n",
        "    y = np.zeros(n - m + 1)\n",
        "    for i in range(len(y)):\n",
        "        y[i] = np.sum(x[i:i+m] * h[::-1])\n",
        "    return y\n",
        "\n",
        "x_test = np.array([0, 0, 1, 2, 3, 2, 1, 0, 0], dtype=float)\n",
        "h_test = np.array([0.25, 0.5, 0.25])  # promedio ponderado de 3 muestras\n",
        "\n",
        "y_manual = conv_manual(x_test, h_test)\n",
        "y_numpy = np.convolve(x_test, h_test, mode='valid')\n",
        "\n",
        "print('manual:', y_manual)\n",
        "print('numpy: ', y_numpy)\n",
        "print('iguales?', np.allclose(y_manual, y_numpy))"
      ],
      "id": "4OIgiDScoCWH"
    },
