        "def plot_spectrum(x, fs, ax=None, fmax=None, title=None):\n",
        "    X = np.abs(rfft(x))\n",
        "    freqs = rfftfreq(len(x), 1.0 / fs)\n",
        "    if ax is None:\n",
        "        fig, ax = plt.subplots()\n",
        "    ax.plot(freqs, X)\n",
        "    if fmax is not None:\n",
        "        ax.set_xlim(0, fmax)\n",
        "    ax.set_xlabel('frecuencia [Hz]'); ax.set_ylabel('|X(f)|')\n",
        "    if title:\n",
        "        ax.set_title(title)\n",
        "    return ax\n",
